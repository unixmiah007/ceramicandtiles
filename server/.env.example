# Gmail SMTP settings for the contact form
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=PortilloCeramicTile@gmail.com
SMTP_PASS=your-gmail-app-password

# Where quote requests are delivered
CONTACT_EMAIL_TO=PortilloCeramicTile@gmail.com
CONTACT_EMAIL_FROM=PortilloCeramicTile@gmail.com

# Optional
PORT=3001
CLIENT_URL=http://localhost:5173

# Optional live chat AI (uses built-in assistant when not set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# Gmail SMTP settings for the contact form
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Gmail account used to send mail (must match the account that created the app password)
SMTP_USER=your-gmail-account@gmail.com
SMTP_PASS=your-gmail-app-password

# Where quote requests are delivered (can differ from SMTP_USER)
CONTACT_EMAIL_TO=PortilloCeramicTile@gmail.com
CONTACT_EMAIL_CC=shaj.k.miah@gmail.com,anthonyportillo1515@gmail.com
CONTACT_EMAIL_FROM=your-gmail-account@gmail.com

# Optional
PORT=3001
CLIENT_URL=http://localhost:5173
SITE_URL=https://ceramicandtile.com

# Optional: SMS alerts via free carrier email-to-SMS (uses the SMTP settings above)
# Default numbers: 571-512-2599, 703-867-0742, 703-867-8773
SMS_ALERT_NUMBERS=5715122599,7038670742,7038678773

# Optional live chat AI (uses built-in assistant when not set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
